FROM ghcr.io/pyo3/maturin:v1.14.1@sha256:2665227312dd1eab1c29c70a001dc8aac53155a2d048bede3b2df7f1691c8e38 AS build

ARG SOURCE_DATE_EPOCH

# The CLI binary is built in the same stage as the crate and the wheel,
# with the same compiler, SOURCE_DATE_EPOCH, path remapping and symbol
# stripping, so the double build of release.ps1 covers it too. The
# manylinux2014 image links it against an old glibc, which keeps it
# portable across Linux distributions.
ENV CARGO_INCREMENTAL=0 \
    CARGO_TARGET_DIR=/tmp/cargo-target \
    RUSTFLAGS="--remap-path-prefix=/io=/workspace -C strip=symbols" \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# The release compiler is the one rust-toolchain.toml pins, installed
# explicitly rather than taken from whatever stable the image ships.
RUN rustup toolchain install 1.98.1 --profile minimal

WORKDIR /io
COPY . .

RUN find . -type d -exec chmod 0755 {} + \
    && find . -type f -exec chmod 0644 {} + \
    && find . -type f \( \
        -name "*.json" -o \
        -name "*.md" -o \
        -name "*.ps1" -o \
        -name "*.py" -o \
        -name "*.pyi" -o \
        -name "*.rs" -o \
        -name "*.toml" -o \
        -name "*.yaml" -o \
        -name "*.yml" -o \
        -name "Cargo.lock" -o \
        -name "Dockerfile*" \
    \) -exec sed -i 's/\r$//' {} +

RUN test -n "${SOURCE_DATE_EPOCH}" \
    && case "${SOURCE_DATE_EPOCH}" in *[!0-9]*) exit 1 ;; esac \
    && cargo package --package plenora-rest-core --locked --allow-dirty --no-verify \
    && mkdir -p /tmp/release-artifacts /tmp/wheels \
    && cp /tmp/cargo-target/package/plenora-rest-core-*.crate /tmp/release-artifacts/ \
    && maturin build \
        --release \
        --locked \
        --strip \
        --compatibility manylinux2014 \
        --interpreter /opt/python/cp310-cp310/bin/python \
        --out /tmp/wheels \
    && cp /tmp/wheels/*.whl /tmp/release-artifacts/ \
    && cargo build \
        --release \
        --locked \
        --package plenora-rest-cli \
        --bin plenora-rest \
    && cp /tmp/cargo-target/release/plenora-rest \
        /tmp/release-artifacts/plenora-rest-linux-x86_64 \
    && /tmp/release-artifacts/plenora-rest-linux-x86_64 --version --format json

FROM build AS python-abi3

RUN set -eux; \
    for tag in cp310-cp310 cp311-cp311 cp312-cp312 cp313-cp313 cp314-cp314; do \
        interpreter="/opt/python/${tag}/bin/python"; \
        target="/tmp/abi3-${tag}"; \
        "${interpreter}" -m pip install \
            --disable-pip-version-check \
            --no-deps \
            --target "${target}" \
            /tmp/wheels/*.whl; \
        cd /tmp; \
        PYTHONPATH="${target}" "${interpreter}" -m unittest \
            discover \
            -s /io/python/tests \
            -v; \
    done

FROM scratch AS artifacts
COPY --from=build /tmp/release-artifacts/ /
