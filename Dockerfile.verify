FROM rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS msrv

# rust-toolchain.toml names the gate compiler; this stage checks the
# published MSRV instead, with the compiler of its own image.
ENV CARGO_INCREMENTAL=0 \
    CARGO_TARGET_DIR=/tmp/cargo-msrv-target \
    RUSTUP_TOOLCHAIN=1.98.0 \
    PYO3_NO_PYTHON=1

WORKDIR /workspace
COPY . .

RUN cargo check --workspace --all-targets --locked \
    && printf "rust-1.98.0\n" > /tmp/msrv-ok

# The compiler rust-toolchain.toml pins.
FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

COPY scripts/install_python.sh /tmp/install_python.sh

ENV LD_LIBRARY_PATH=/opt/python314/lib \
    PYO3_PYTHON=/opt/verify/bin/python

RUN rustup component add rustfmt clippy \
    && apt-get update \
    && apt-get install -y --no-install-recommends patchelf build-essential curl xz-utils libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev libffi-dev liblzma-dev \
    && rm -rf /var/lib/apt/lists/* \
    && sh /tmp/install_python.sh /opt/python314 \
    && /opt/python314/bin/python3.14 -m venv /opt/verify \
    && /opt/verify/bin/pip install \
        "jsonschema==4.26.0" \
        "maturin==1.16.0"

WORKDIR /workspace
COPY . .
COPY --from=msrv /tmp/msrv-ok /tmp/msrv-ok

RUN test -f /tmp/msrv-ok \
    && /opt/verify/bin/python -m py_compile \
        scripts/release.py \
        scripts/validate_contracts.py \
    && /opt/verify/bin/python scripts/release.py current-version \
    && /opt/verify/bin/python scripts/validate_contracts.py \
    && /opt/verify/bin/pip install -r scripts/assurance-requirements.txt \
    && /opt/verify/bin/python scripts/check_python_version.py --runtime \
    && /opt/verify/bin/python scripts/check_assurance.py \
    && /opt/verify/bin/python -m unittest discover -s scripts \
    && /opt/verify/bin/python scripts/check_comments.py \
    && /opt/verify/bin/python scripts/check_docs.py
RUN cargo fmt --all -- --check
RUN cargo clippy --workspace --all-targets --locked -- -D warnings
# Library and binary code must not be able to panic: no unwrap, expect or panic, no
# indexing or slicing that can go out of bounds. Tests are exempt, and so is
# the campaign harness (crates/rest-campaign): it ships in no artifact, and a
# panic there already fails the campaign.
RUN cargo clippy --workspace --exclude plenora-rest-campaign --lib --bins --locked -- \
    -D clippy::unwrap_used -D clippy::expect_used -D clippy::panic \
    -D clippy::indexing_slicing -D clippy::unreachable \
    -D clippy::todo -D clippy::unimplemented
RUN /opt/verify/bin/python scripts/check_packages.py
RUN cargo test --workspace --locked
RUN RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --locked
RUN /opt/verify/bin/maturin build --release --locked --out /tmp/wheels
RUN /opt/python314/bin/python3.14 -m venv /tmp/wheel-test \
    && /tmp/wheel-test/bin/pip install /tmp/wheels/*.whl \
    && cd /tmp \
    && /tmp/wheel-test/bin/python -m unittest discover -s /workspace/python/tests -v
