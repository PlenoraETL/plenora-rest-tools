FROM rust:1.85.1-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS msrv

ENV CARGO_INCREMENTAL=0 \
    CARGO_TARGET_DIR=/tmp/cargo-msrv-target

WORKDIR /workspace
COPY . .

RUN cargo check --workspace --all-targets --locked \
    && printf "rust-1.85.1\n" > /tmp/msrv-ok

FROM rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN rustup component add rustfmt clippy \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3-venv patchelf \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/verify \
    && /opt/verify/bin/pip install \
        "jsonschema==4.25.1" \
        "maturin==1.14.1"

WORKDIR /workspace
COPY . .
COPY --from=msrv /tmp/msrv-ok /tmp/msrv-ok

RUN test -f /tmp/msrv-ok \
    && /opt/verify/bin/python -m py_compile \
        scripts/release.py \
        scripts/validate_contracts.py \
    && /opt/verify/bin/python scripts/release.py current-version \
    && /opt/verify/bin/python scripts/validate_contracts.py
RUN cargo fmt --all -- --check
RUN cargo clippy --workspace --all-targets -- -D warnings
RUN cargo test --workspace
RUN /opt/verify/bin/maturin build --release --locked --out /tmp/wheels
RUN python3 -m venv /tmp/wheel-test \
    && /tmp/wheel-test/bin/pip install /tmp/wheels/*.whl \
    && cd /tmp \
    && /tmp/wheel-test/bin/python -m unittest discover -s /workspace/python/tests -v
