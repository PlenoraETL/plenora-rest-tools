{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/adoption-manifest-v4.schema.json",
  "title": "Plenora public-contract adoption manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "component", "contracts_source", "profile",
    "artifacts", "contracts", "deviations"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "component": {
      "type": "string",
      "pattern": "^plenora-[a-z][a-z0-9-]{1,62}$"
    },
    "contracts_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "https://github.com/PlenoraETL/plenora-contracts.git"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^plenora-[a-z0-9-]+-profile-v[1-9][0-9]*$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contractAdoption"}
    },
    "deviations": {
      "type": "array",
      "items": {"$ref": "#/$defs/deviation"}
    }
  },
  "$defs": {
    "surface": {"enum": ["rust", "cli", "python_sdk", "runtime"]},
    "apiMode": {"enum": ["sync", "async"]},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "surface", "version", "digest", "verification"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "surface": {"$ref": "#/$defs/surface"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "api_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/apiMode"}
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"surface": {"const": "python_sdk"}},
            "required": ["surface"]
          },
          "then": {"required": ["api_modes"]},
          "else": {"not": {"required": ["api_modes"]}}
        }
      ]
    },
    "contractAdoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^plenora-[a-z0-9-]+-v[1-9][0-9]*$"
        },
        "status": {"enum": ["conforming", "not_applicable"]},
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "conforming"}},
            "required": ["status"]
          },
          "then": {"required": ["verification"]},
          "else": {"not": {"required": ["verification"]}}
        }
      ]
    },
    "deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule", "observed_behavior", "tracking",
        "detectable_before_invocation"
      ],
      "properties": {
        "rule": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact": {"type": "string", "minLength": 1, "maxLength": 128},
        "surface": {"$ref": "#/$defs/surface"},
        "observed_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "tracking": {"type": "string", "minLength": 1, "maxLength": 256},
        "detectable_before_invocation": {"type": "boolean"}
      },
      "anyOf": [
        {"required": ["artifact"]},
        {"required": ["surface"]}
      ]
    }
  }
}
