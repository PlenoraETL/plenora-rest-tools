{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/public-catalog-v1.schema.json",
  "title": "Plenora normative public operation catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "component",
    "profile",
    "status",
    "target_surfaces",
    "operations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contract": {"const": "plenora-public-catalog-v1"},
    "component": {
      "type": "string",
      "pattern": "^plenora-[a-z][a-z0-9-]+-tools$"
    },
    "profile": {"$ref": "#/$defs/contractId"},
    "status": {"enum": ["normative", "provisional"]},
    "target_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust", "cli", "python_sdk", "runtime"],
      "properties": {
        "rust": {"$ref": "#/$defs/applicability"},
        "cli": {"$ref": "#/$defs/applicability"},
        "python_sdk": {"$ref": "#/$defs/applicability"},
        "runtime": {"$ref": "#/$defs/applicability"}
      }
    },
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "contractId": {
      "type": "string",
      "pattern": "^plenora-[a-z0-9-]+-v[1-9][0-9]*$"
    },
    "applicability": {
      "enum": ["required", "conditional", "not_applicable", "undecided"]
    },
    "surface": {"enum": ["rust", "cli", "python_sdk", "runtime"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "content_types", "interchange_contracts"],
      "properties": {
        "contract": {"$ref": "#/$defs/contractId"},
        "content_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
          }
        },
        "interchange_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contractId"}
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellation", "deadline", "idempotency_key"],
      "properties": {
        "cancellation": {"type": "boolean"},
        "deadline": {"type": "boolean"},
        "idempotency_key": {"type": "boolean"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "requirement",
        "summary",
        "surfaces",
        "input",
        "output",
        "side_effect",
        "controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "version": {"type": "integer", "minimum": 1},
        "requirement": {"enum": ["required", "conditional", "extension"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 240},
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/surface"}
        },
        "input": {"$ref": "#/$defs/payload"},
        "output": {"$ref": "#/$defs/payload"},
        "side_effect": {"enum": ["none", "local", "remote"]},
        "controls": {"$ref": "#/$defs/controls"},
        "attributes": {"type": "object"}
      }
    }
  }
}
