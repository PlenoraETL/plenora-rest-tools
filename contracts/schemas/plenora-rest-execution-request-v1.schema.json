{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/components/rest/plenora-rest-execution-request-v1.schema.json",
  "title": "Plenora REST execution request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "connection"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["test", "generate", "enrich"]},
    "connection": {"$ref": "#/$defs/connection"},
    "input": {"$ref": "#/$defs/executionInput"},
    "options": {"$ref": "#/$defs/options"}
  },
  "$defs": {
    "jsonObject": {"type": "object"},
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1, "maxLength": 8192},
        "method": {"type": "string", "minLength": 1, "maxLength": 64},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "auth": {"type": "object"},
        "credential_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "parameters": {"type": "array", "items": {"type": "object"}},
        "static_parameters": {"$ref": "#/$defs/jsonObject"},
        "request": {"type": "object"},
        "response": {"type": "object"},
        "retry": {"type": "object"},
        "cookies": {"type": "object"},
        "cache": {"type": "object"},
        "circuit_breaker": {"type": "object"},
        "idempotency": {"$ref": "#/$defs/idempotency"},
        "pagination": {"type": ["object", "null"]},
        "polling": {
          "oneOf": [
            {"$ref": "#/$defs/polling"},
            {"type": "null"}
          ]
        },
        "batch": {"type": ["object", "null"]},
        "success_statuses": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "requests_per_second": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "tls": {"type": "object"},
        "proxy": {"type": ["object", "null"]}
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "location": {"enum": ["header", "query", "body"]}
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url_path": {"type": ["string", "null"], "maxLength": 4096},
        "url_template": {"type": ["string", "null"], "maxLength": 8192},
        "id_path": {"type": "string", "maxLength": 4096},
        "id_header": {"type": ["string", "null"], "maxLength": 256},
        "location_header": {"type": ["string", "null"], "maxLength": 256},
        "method": {"type": "string", "minLength": 1, "maxLength": 64},
        "status_path": {"type": "string", "maxLength": 4096},
        "result_path": {"type": ["string", "null"], "maxLength": 4096},
        "result_url_path": {"type": ["string", "null"], "maxLength": 4096},
        "result_url_template": {"type": ["string", "null"], "maxLength": 8192},
        "result_method": {"type": "string", "minLength": 1, "maxLength": 64},
        "pending_values": {"$ref": "#/$defs/statusValues"},
        "success_values": {"$ref": "#/$defs/statusValues"},
        "failure_values": {"$ref": "#/$defs/statusValues"},
        "interval_ms": {"type": "integer", "minimum": 0},
        "interval_backoff": {"type": "number", "minimum": 1},
        "max_interval_ms": {"type": "integer", "minimum": 0},
        "max_wait_ms": {"type": ["integer", "null"], "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "allow_cross_origin": {"type": "boolean"},
        "resume": {
          "oneOf": [
            {"$ref": "#/$defs/pollingResume"},
            {"type": "null"}
          ]
        },
        "cancel": {
          "oneOf": [
            {"$ref": "#/$defs/pollingCancel"},
            {"type": "null"}
          ]
        }
      }
    },
    "statusValues": {
      "type": "array",
      "maxItems": 128,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "pollingResume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "pollingCancel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url_template": {"type": ["string", "null"], "maxLength": 8192},
        "method": {"type": "string", "minLength": 1, "maxLength": 64},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "on_cancellation": {"type": "boolean"},
        "on_deadline": {"type": "boolean"},
        "on_poll_timeout": {"type": "boolean"}
      }
    },
    "executionInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {"$ref": "#/$defs/jsonObject"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/jsonObject"}}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continue_on_error": {"type": "boolean"},
        "capture_response_metadata": {"type": "boolean"},
        "response_headers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "enrichment_concurrency": {"type": "integer", "minimum": 1},
        "deadline": {"type": ["string", "null"], "format": "date-time"},
        "idempotency_key": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[!-~]+$"
        }
      }
    }
  }
}
