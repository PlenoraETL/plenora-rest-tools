{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/components/rest/plenora-rest-execution-request-v1.schema.json",
  "title": "Plenora REST execution request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "connection"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"enum": ["test", "generate", "enrich"]},
    "connection": {"$ref": "#/$defs/connection"},
    "input": {"$ref": "#/$defs/executionInput"},
    "options": {"$ref": "#/$defs/options"}
  },
  "$defs": {
    "jsonObject": {"type": "object"},
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1, "maxLength": 8192},
        "method": {"type": "string", "minLength": 1, "maxLength": 64},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "auth": {"type": "object"},
        "credential_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
        "parameters": {"type": "array", "items": {"type": "object"}},
        "static_parameters": {"$ref": "#/$defs/jsonObject"},
        "request": {"type": "object"},
        "response": {"type": "object"},
        "retry": {"type": "object"},
        "cookies": {"type": "object"},
        "cache": {"type": "object"},
        "circuit_breaker": {"type": "object"},
        "pagination": {"type": ["object", "null"]},
        "polling": {"type": ["object", "null"]},
        "batch": {"type": ["object", "null"]},
        "success_statuses": {"type": "array", "items": {"type": "integer", "minimum": 100, "maximum": 599}},
        "requests_per_second": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "tls": {"type": "object"},
        "proxy": {"type": ["object", "null"]}
      }
    },
    "executionInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {"$ref": "#/$defs/jsonObject"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/jsonObject"}}
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "continue_on_error": {"type": "boolean"},
        "capture_response_metadata": {"type": "boolean"},
        "response_headers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "enrichment_concurrency": {"type": "integer", "minimum": 1},
        "deadline": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
